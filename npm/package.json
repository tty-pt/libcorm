{
  "name": "@tty-pt/corm",
  "version": "2.2.2",
  "type": "module",
  "description": "Universal Node.js and Browser bindings for libcorm and Corm Recall Kernel (cormr)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "include",
    "assets",
    "*.pc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "mkdir -p build/Release && gcc -O3 -fPIC -shared -I/usr/include/node -I../include native/corm_napi.c -L../lib -Wl,-rpath,../lib -L/usr/lib -lcorm -o build/Release/corm_node.node 2>/dev/null || true",
    "build:wasm": "clang --target=wasm32-wasi -mexec-model=reactor -Wl,--no-entry -Wl,--allow-undefined -Wl,--export=cormr_set_new -Wl,--export=cormr_set_push -Wl,--export=cormr_set_seal -Wl,--export=cormr_set_count -Wl,--export=cormr_set_at -Wl,--export=cormr_set_intersect -Wl,--export=cormr_set_union -Wl,--export=cormr_set_subtract -Wl,--export=cormr_set_free -Wl,--export=malloc -Wl,--export=free -I../include -ffreestanding -O3 -o dist/corm.wasm ../src/rec.c 2>/dev/null || true",
    "build": "npm run build:native && npm run build:wasm",
    "test": "node --test tests/corm.test.mjs"
  },
  "dependencies": {
    "@tty-pt/stele": "^0.1.0"
  },
  "peerDependencies": {
    "@tty-pt/stele": ">=0.1.0"
  },
  "keywords": [
    "corm",
    "libcorm",
    "cormr",
    "storage",
    "set-algebra",
    "ranking",
    "napi"
  ],
  "author": "Paulo Quirino",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-pt/libcorm.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/tty-pt/libcorm/tree/main/npm#readme",
  "bugs": {
    "url": "https://github.com/tty-pt/libcorm/issues"
  }
}
